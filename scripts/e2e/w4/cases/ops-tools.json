    "case_id": "w4_diff_as_of_scn_detects_change",
    "tool": "oracle_diff",
    "level": "READ_WRITE",
    "transports": [
      "stdio",
      "http"
    ],
    "requires": [],
    "setup": [],
    "setup_phase": "before_server",
    "flashback_grant_owner": true,
    "setup_ready_sql": "SELECT ID FROM ${owner}.T_PARENT_${run_id} AS OF SCN (DBMS_FLASHBACK.GET_SYSTEM_CHANGE_NUMBER) WHERE ID=1",
    "call": {
      "arguments": {
        "sql": "SELECT ID, LABEL FROM T_PARENT_${run_id} WHERE ID=1",
        "key": [
          "ID"
        ],
        "scn_a": "${cap:scn_a}",
        "scn_b": "${cap:scn_b}"
      },
      "mutation": true
    },
    "expect": {
      "json_subset": {
        "changed": [
          {
            "key": {
              "ID": "1"
            },
            "before": {
              "ID": "1",
              "LABEL": "parent-1"
            },
            "after": {
              "ID": "1",
              "LABEL": "parent-5"
            }
          }
        ],
        "added": [],
        "removed": [],
        "columns": [
          "ID",
          "LABEL"
        ],
        "key_columns": [
          "ID"
        ],
        "keyed": true,
        "row_count_a": 1,
        "row_count_b": 1,
        "truncated": false
      }
    },
    "db_reread": [
      {
        "sql": "SELECT ID,LABEL FROM ${owner}.T_PARENT_${run_id} WHERE ID=1",
        "rows": [
          [
            1,
            "parent-5"
          ]
        ]
      }
    ],
    "audit_expect": [
      {
        "tool": "oracle_execute",
        "decision": "ALLOWED",
        "outcome": "PENDING"
      },
      {
        "tool": "oracle_execute",
        "decision": "ALLOWED",
        "outcome": "SUCCEEDED",
        "rows_affected": 1
      }
    ],
    "on_unsupported": {
      "error_class": "FLASHBACK_CAPABILITY_UNAVAILABLE"
    },
    "cleanup": [
      {
        "sql": "UPDATE ${owner}.T_PARENT_${run_id} SET LABEL='parent-1' WHERE ID=1"
      }
    ],
    "profile_variant": "synthetic_owner_rw",
    "steps": [
      {
        "external_scn_capture": "scn_a"
      },
      {
        "tool": "oracle_preview_sql",
        "arguments": {
          "sql": "UPDATE T_PARENT_${run_id} SET LABEL='parent-5' WHERE ID=1",
          "commit": true
        },
        "expect": {
          "json_subset": {
            "execute_confirmation": {}
          }
        },
        "capture": {
          "commit_token": "/execute_confirmation/confirm"
        }
      },
      {
        "tool": "oracle_execute",
        "arguments": {
          "sql": "UPDATE T_PARENT_${run_id} SET LABEL='parent-5' WHERE ID=1",
          "commit": true,
          "confirm": "${cap:commit_token}"
        },
        "expect": {
          "json_subset": {
            "executed": true,
            "committed": true,
            "rolled_back": false,
            "rows_affected": 1
          }
        },
        "capture": {}
      },
      {
        "audit_record": {
          "tool": "oracle_execute",
          "decision": "ALLOWED",
          "outcome": "SUCCEEDED",
          "rows_affected": 1
        }
      },
      {
        "external_scn_capture": "scn_b"
      }
    ],
    "cleanup_reread": [
      {
        "sql": "SELECT ID,LABEL FROM ${owner}.T_PARENT_${run_id} WHERE ID=1",
        "rows": [
          [
            1,
            "parent-1"
          ]
        ]
      }
    ]
