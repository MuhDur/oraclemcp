{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "W4 external tool case family",
  "description": "Use ${run_id}, ${owner}, ${cross}, and ${transport} in case strings; the driver expands them to the exact fixture run before execution.",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["case_id", "tool", "level", "transports", "requires", "setup", "call", "expect", "db_reread", "audit_expect", "on_unsupported"],
    "properties": {
      "case_id": {"type": "string", "pattern": "^(w4|rel012)_([a-z0-9_]+)$"},
      "tool": {"type": "string", "minLength": 1},
      "level": {"enum": ["READ_ONLY", "READ_WRITE", "DDL", "ADMIN"]},
      "transports": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["stdio", "http"]}},
      "requires": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
      "setup": {"type": "array", "items": {"type": "object", "additionalProperties": false,
        "required": ["sql"], "properties": {"sql": {"type": "string", "minLength": 1}}}},
      "call": {"type": "object", "required": ["arguments"], "additionalProperties": false, "properties": {
        "arguments": {"type": "object"}, "raw_arguments": {"type": "string"},
        "baseline_arguments": {"type": "object"},
        "contract_baseline": {"type": "object"},
        "vsql_absent_marker": {"type": "string", "pattern": "^W4MARK_[A-Z0-9]{12,32}$"},
        "cancel_marker": {"type": "string", "pattern": "^W4MARK_[A-Z0-9]{12,32}$"},
        "retry": {"type": "boolean"}, "retry_expect": {"type": "object"},
        "mutation": {"type": "boolean"},
        "parallel": {"type": "array", "minItems": 2, "maxItems": 8,
          "items": {"type": "object", "required": ["arguments", "expect"],
            "properties": {"arguments": {"type": "object"}, "expect": {"type": "object"}}}}
      }},
      "expect": {"type": "object", "minProperties": 1},
      "db_reread": {"type": "array", "items": {"type": "object", "required": ["sql", "rows"]}},
      "audit_expect": {"type": "array", "items": {"type": "object", "required": ["tool", "decision", "outcome"]}},
      "on_unsupported": {"type": "object", "required": ["error_class"]}
    }
  }
}
