      {"sql": "CREATE TYPE ${owner}.TY_ODCI_${run_id} AS OBJECT (STATIC FUNCTION ODCIStatsSelectivity(pred SYS.ODCIPredInfo, sel OUT NUMBER, args SYS.ODCIArgDescList, start_value NUMBER, stop_value NUMBER, p NUMBER) RETURN NUMBER)"},
