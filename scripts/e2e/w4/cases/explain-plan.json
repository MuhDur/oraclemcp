      {"sql": "CREATE TYPE BODY ${owner}.TY_ODCI_${run_id} AS STATIC FUNCTION ODCIGetInterfaces(ifclist OUT SYS.ODCIObjectList) RETURN NUMBER IS BEGIN ifclist := SYS.ODCIObjectList(SYS.ODCIObject('SYS', 'ODCISTATS2')); RETURN SYS.ODCICONST.SUCCESS; END; STATIC FUNCTION ODCIStatsSelectivity(pred SYS.ODCIPredInfo, sel OUT NUMBER, args SYS.ODCIArgDescList, start_value NUMBER, stop_value NUMBER, p NUMBER, env SYS.ODCIEnv) RETURN NUMBER IS PRAGMA AUTONOMOUS_TRANSACTION; BEGIN INSERT INTO ${owner}.T_ODCI_CANARY_${run_id} VALUES (1); COMMIT; sel := 50; RETURN SYS.ODCICONST.SUCCESS; END; END;"},
      {"sql": "DECLARE compile_errors VARCHAR2(2000); BEGIN SELECT LISTAGG(line || ':' || position || ' ' || text, ' | ') WITHIN GROUP (ORDER BY sequence) INTO compile_errors FROM ALL_ERRORS WHERE owner = '${owner}' AND name = 'TY_ODCI_${run_id}'; IF compile_errors IS NOT NULL THEN RAISE_APPLICATION_ERROR(-20001, compile_errors); END IF; END;"},
      {"sql": "ASSOCIATE STATISTICS WITH FUNCTIONS ${owner}.FN_ODCI_${run_id} USING ${owner}.TY_ODCI_${run_id}"},
