    },
    "db_reread": [
      {
        "sql": "SELECT object_name,object_type,status FROM SYS.all_objects WHERE owner='${owner}' AND object_name='T_DELTA_${run_id}' ORDER BY object_type",
        "rows": [
          [
            "T_DELTA_${run_id}",
            "TABLE",
            "VALID"
          ]
        ]
      }
    ],
    "cleanup": [
      {
        "sql": "DROP TABLE ${owner}.T_DELTA_${run_id} PURGE"
      }
    ],
    "cleanup_reread": [
      {
