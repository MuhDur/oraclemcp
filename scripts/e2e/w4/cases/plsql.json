    "case_id": "w4_plsql_blast_radius_dependents_exact",
    "tool": "oracle_plsql_blast_radius",
    "level": "READ_ONLY",
    "transports": [
      "stdio",
      "http"
    ],
    "requires": [],
    "setup": [
      {
        "sql": "CREATE OR REPLACE PROCEDURE ${owner}.P_DEP_${run_id} AS v NUMBER; BEGIN v := ${owner}.PKG_W4_${run_id}.PURE_FN(1); END;"
      },
      {
        "sql": "CREATE OR REPLACE PROCEDURE ${owner}.P_DEP2_${run_id} AS BEGIN ${owner}.P_DEP_${run_id}; END;"
      }
    ],
    "call": {
      "arguments": {
        "schemas": [
          "${owner}"
        ],
        "include_plscope": false,
        "include_snapshot": false,
        "changeset": {
          "objects": []
        },
        "mode": "live_snapshot"
      }
    },
    "expect": {
      "json_subset": {
        "prediction": {
          "payload": {
            "summary": {
              "invalidation_count": 4,
              "recompile_count": 3,
              "uncertainty_count": 0
            }
          }
        }
      }
    },
    "db_reread": [
      {
        "sql": "SELECT object_name,status FROM SYS.all_objects WHERE owner='${owner}' AND object_name IN ('P_DEP_${run_id}','P_DEP2_${run_id}') ORDER BY object_name",
        "rows": [
          [
            "P_DEP2_${run_id}",
            "VALID"
          ],
          [
            "P_DEP_${run_id}",
            "VALID"
          ]
        ]
      }
    ],
    "cleanup": [
      {
        "sql": "DROP PROCEDURE ${owner}.P_DEP2_${run_id}"
      },
      {
        "sql": "DROP PROCEDURE ${owner}.P_DEP_${run_id}"
      }
    ],
    "cleanup_reread": [
      {
        "sql": "SELECT object_name,status FROM SYS.all_objects WHERE owner='${owner}' AND object_name IN ('P_DEP_${run_id}','P_DEP2_${run_id}') ORDER BY object_name",
        "rows": []
      }
    ],
    "audit_expect": [],
    "on_unsupported": {
      "error_class": "INVALID_ARGUMENTS"
    }
  },
