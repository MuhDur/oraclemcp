# The release build context is an allowlist. `COPY . .` therefore cannot upload
# local credentials, Oracle wallets, operator state, agent state, quarantine,
# test evidence, or unrelated untracked files into BuildKit/cache.
**

!Cargo.toml
!Cargo.lock
!rust-toolchain.toml

!.cargo/
.cargo/**
!.cargo/config.toml

!scripts/
scripts/**
!scripts/cargo_build_guard.sh
!scripts/check_build_lease.sh

!crates/
crates/**
!crates/*/
crates/*/**
!crates/*/Cargo.toml
!crates/*/README.md
!crates/*/src/
crates/*/src/**
!crates/*/src/**
!crates/oraclemcp-db/benches/
crates/oraclemcp-db/benches/**
!crates/oraclemcp-db/benches/classify_type.rs
!crates/oraclemcp-db/benches/lob_capping.rs
!crates/oraclemcp-db/benches/page_serialization.rs
!crates/oraclemcp/install.sh
!crates/oraclemcp/install.ps1
!crates/oraclemcp-core/ci_taxonomy.json

!web/
web/**
!web/dist/
web/dist/**
!web/dist/**

